# RepairPath Environment Configuration Template
# Copy this file to .env.local to configure environment variables locally.
# DO NOT commit real API keys or .env / .env.local files to Git.

# Optional: Google Gemini API Key for AI Diagnostic Copilot
# If left empty, RepairPath automatically uses its built-in Smart Appliance Diagnostic Knowledge Engine.
# Alternatively, users can enter their key directly within the app settings (stored exclusively in browser localStorage).
VITE_GEMINI_API_KEY=
